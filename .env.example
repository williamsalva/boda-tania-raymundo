# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Pública: solo sirve para iniciar sesión en el panel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas con el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Correos que pueden entrar a /admin, separados por coma.
ADMIN_EMAILS=tania@correo.com,raymundo@correo.com

# URL pública para la vista previa al compartir por WhatsApp (en Vercel se detecta sola)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
